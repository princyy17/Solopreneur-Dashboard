@using FreelanceManager.Enums
@model List<AllClientsVM>
@{
    ViewData["Title"] = "Clients";
}

<style>
@@keyframes cardIn { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
.client-card { animation: cardIn 0.35s ease both; }
.pill.active { background:#1e293b; color:#fff; border-color:#1e293b; }
.sort-btn.active { background:#eff6ff; color:#1d4ed8; }
</style>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
    <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900">Clients</h1>
        <p class="text-gray-500 text-sm mt-1"><span id="clientCount">@Model.Count</span> clients total</p>
    </div>
    <a href="/Clients/Add"
       class="flex items-center gap-2 bg-gray-900 hover:bg-gray-700 text-white px-5 py-2.5 rounded-xl font-medium text-sm transition-colors shrink-0">
        <i class="fa-solid fa-plus"></i> Add Client
    </a>
</div>

<!-- Filter bar -->
<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-5">
    <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input id="clientSearch" type="text" placeholder="Search by name, email, or phone..."
                   class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"/>
        </div>
        <div class="flex gap-1.5 items-center">
            <span class="text-xs text-gray-400 mr-1 hidden sm:block">Sort:</span>
            <button class="sort-btn active text-xs px-3 py-2 rounded-xl border border-gray-200 font-medium transition-colors" data-sort="default">Default</button>
            <button class="sort-btn text-xs px-3 py-2 rounded-xl border border-gray-200 font-medium text-gray-600 transition-colors" data-sort="name">Name A–Z</button>
            <button class="sort-btn text-xs px-3 py-2 rounded-xl border border-gray-200 font-medium text-gray-600 transition-colors" data-sort="name-desc">Name Z–A</button>
        </div>
    </div>
    <div class="flex flex-wrap gap-2 mt-3 items-center">
        <span class="text-xs text-gray-400 mr-1">Status:</span>
        <button class="pill active text-xs px-3 py-1.5 rounded-full border border-gray-200 font-medium transition-all" data-status="">All</button>
        <button class="pill text-xs px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 font-medium transition-all" data-status="Active">
            <span class="w-2 h-2 rounded-full bg-green-500 inline-block mr-1"></span>Active
        </button>
        <button class="pill text-xs px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 font-medium transition-all" data-status="Inactive">
            <span class="w-2 h-2 rounded-full bg-gray-400 inline-block mr-1"></span>Inactive
        </button>
    </div>
</div>

<div id="emptyClients" class="hidden text-center py-16 bg-white rounded-2xl border border-gray-100">
    <i class="fa-solid fa-users-slash text-4xl text-gray-200 mb-3"></i>
    <p class="text-gray-500 font-medium">No clients match your search</p>
    <button onclick="clearClientFilters()" class="mt-3 text-blue-600 text-sm hover:underline">Clear filters</button>
</div>

<div id="clientGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 pb-8">
    @foreach (var client in Model)
    {
        var isActive = client.Status.ToString() == "Active";
        var statusBg = isActive ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-500";
        var dotBg    = isActive ? "bg-green-500" : "bg-gray-400";

        <div class="client-card bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all"
             data-name="@client.Name.ToLower()"
             data-email="@(client.Email?.ToLower() ?? "")"
             data-phone="@(client.Phone?.ToLower() ?? "")"
             data-status="@client.Status">

            <div class="p-5 pb-4">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-lg shrink-0">
                        @client.Name.FirstOrDefault()
                    </div>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full @statusBg">
                        <span class="w-1.5 h-1.5 rounded-full inline-block mr-1 @dotBg"></span>@client.Status
                    </span>
                </div>
                <h3 class="font-bold text-gray-900 text-base mb-0.5">@client.Name</h3>
                @if (!string.IsNullOrEmpty(client.Email))
                {
                    <p class="text-xs text-gray-500 flex items-center gap-1.5 mb-1">
                        <i class="fa-solid fa-envelope text-gray-400"></i>
                        <span class="truncate">@client.Email</span>
                    </p>
                }
                @if (!string.IsNullOrEmpty(client.Phone))
                {
                    <p class="text-xs text-gray-500 flex items-center gap-1.5">
                        <i class="fa-solid fa-phone text-gray-400"></i> @client.Phone
                    </p>
                }
                @if (client.TasksCount > 0)
                {
                    <div class="flex gap-3 mt-3 pt-3 border-t border-gray-100 text-xs text-gray-500">
                        <span><strong class="text-gray-800">@client.TasksCount</strong> tasks</span>
                        <span><strong class="text-green-600">@client.CompletedTasks</strong> done</span>
                    </div>
                }
            </div>

            <div class="border-t border-gray-100 px-4 py-3 flex gap-2">
                <a href="/Clients/Details/@client.Id"
                   class="flex-1 text-center text-xs font-medium bg-gray-50 hover:bg-gray-100 text-gray-700 py-2 rounded-xl transition-colors">
                    <i class="fa-regular fa-eye mr-1"></i>Details
                </a>
                <a href="/Clients/Edit/@client.Id"
                   class="flex-1 text-center text-xs font-medium bg-blue-50 hover:bg-blue-100 text-blue-700 py-2 rounded-xl transition-colors">
                    <i class="fa-solid fa-pen mr-1"></i>Edit
                </a>
                <button onclick="openDeleteModal(@client.Id,'@client.Name')"
                        class="flex-1 text-center text-xs font-medium bg-red-50 hover:bg-red-100 text-red-600 py-2 rounded-xl transition-colors">
                    <i class="fa-solid fa-trash mr-1"></i>Delete
                </button>
            </div>
        </div>
    }
</div>

<!-- Delete modal -->
<div id="deleteClientModal" class="fixed inset-0 z-50 bg-black/50 hidden items-center justify-center">
    <div class="bg-white rounded-2xl shadow-2xl max-w-xs w-full mx-4 overflow-hidden">
        <div class="bg-red-50 px-6 py-4 border-b border-red-100">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-trash text-red-600"></i>
                </div>
                <div>
                    <h3 class="font-bold text-gray-900">Delete Client</h3>
                    <p class="text-xs text-gray-500" id="deleteClientName"></p>
                </div>
            </div>
        </div>
        <div class="px-6 py-4">
            <p class="text-sm text-gray-600">This will permanently remove the client. <strong class="text-gray-900">Cannot be undone.</strong></p>
        </div>
        <div class="px-6 pb-5 flex gap-3">
            <button onclick="closeDeleteModal()" class="flex-1 border border-gray-200 text-gray-700 hover:bg-gray-50 py-2.5 rounded-xl font-medium text-sm transition-colors">Cancel</button>
            <form id="deleteClientForm" method="post">
                <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white px-6 py-2.5 rounded-xl font-medium text-sm transition-colors">Delete</button>
            </form>
        </div>
    </div>
</div>

<script>
let filterStatus = '', filterSearch = '';

let dt;
document.getElementById('clientSearch').addEventListener('input', function(){
    clearTimeout(dt);
    dt = setTimeout(()=>{ filterSearch = this.value.toLowerCase(); applyFilters(); }, 180);
});

document.querySelectorAll('.pill').forEach(btn => {
    btn.addEventListener('click', function(){
        document.querySelectorAll('.pill').forEach(b=>b.classList.remove('active'));
        this.classList.add('active');
        filterStatus = this.dataset.status;
        applyFilters();
    });
});

document.querySelectorAll('.sort-btn').forEach(btn => {
    btn.addEventListener('click', function(){
        document.querySelectorAll('.sort-btn').forEach(b=>b.classList.remove('active'));
        this.classList.add('active');
        sortCards(this.dataset.sort);
    });
});
function sortCards(mode){
    const grid = document.getElementById('clientGrid');
    const cards = [...grid.querySelectorAll('.client-card')];
    cards.sort((a,b)=>{
        const na = a.dataset.name, nb = b.dataset.name;
        if(mode==='name') return na.localeCompare(nb);
        if(mode==='name-desc') return nb.localeCompare(na);
        return 0;
    });
    cards.forEach(c=>grid.appendChild(c));
}

function applyFilters(){
    const cards = document.querySelectorAll('.client-card');
    let vis = 0;
    cards.forEach(c=>{
        const matchName   = !filterSearch || c.dataset.name.includes(filterSearch) || c.dataset.email.includes(filterSearch) || c.dataset.phone.includes(filterSearch);
        const matchStatus = !filterStatus || c.dataset.status === filterStatus;
        const show = matchName && matchStatus;
        c.style.display = show ? '' : 'none';
        if(show) vis++;
    });
    document.getElementById('clientCount').textContent = vis;
    document.getElementById('emptyClients').classList.toggle('hidden', vis > 0);
}

function clearClientFilters(){
    document.getElementById('clientSearch').value = '';
    filterSearch = ''; filterStatus = '';
    document.querySelectorAll('.pill').forEach(b=>b.classList.remove('active'));
    document.querySelector('.pill[data-status=""]').classList.add('active');
    applyFilters();
}

function openDeleteModal(id, name){
    document.getElementById('deleteClientName').textContent = name;
    document.getElementById('deleteClientForm').action = '/Clients/Delete/'+id;
    const m = document.getElementById('deleteClientModal');
    m.classList.remove('hidden'); m.classList.add('flex');
}
function closeDeleteModal(){
    const m = document.getElementById('deleteClientModal');
    m.classList.add('hidden'); m.classList.remove('flex');
}
document.getElementById('deleteClientModal').addEventListener('click',e=>{ if(e.target===e.currentTarget) closeDeleteModal(); });
</script>
