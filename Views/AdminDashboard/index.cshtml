@using FreelanceManager.ViewModels.DashboradVM
@model List<DashboardVM>
@{
    ViewData["Title"] = "Admin Dashboard";
    int freelancerNum = Model.Count;
    int projectsNum   = (int)(ViewBag.ProjectsNum ?? 0);
    int missionsNum   = (int)(ViewBag.TasksNum    ?? 0);
    int clientsNum    = (int)(ViewBag.ClientsNum  ?? 0);
}
<style>
@@keyframes slideIn { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
.stat-anim { animation:slideIn 0.4s ease both; }
.stat-anim:nth-child(2){animation-delay:.08s} .stat-anim:nth-child(3){animation-delay:.16s} .stat-anim:nth-child(4){animation-delay:.24s}
.expand-content { max-height:0; overflow:hidden; transition:max-height 0.35s cubic-bezier(0.4,0,0.2,1); }
.expand-content.open { max-height:240px; }
@@keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
.chart-card { animation:fadeUp 0.5s ease both; }
</style>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <div>
        <span class="text-xs font-semibold text-red-600 bg-red-50 border border-red-200 px-2.5 py-1 rounded-full">Admin</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mt-2">Control Panel</h1>
        <p id="adminDate" class="text-gray-500 text-sm mt-1"></p>
    </div>
    <div class="flex gap-2">
        <button onclick="location.reload()" class="flex items-center gap-2 border border-gray-200 text-gray-600 hover:bg-gray-50 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors">
            <i class="fa-solid fa-arrows-rotate"></i> Refresh
        </button>
        <a asp-action="AddNewRole" asp-controller="Role" class="flex items-center gap-2 bg-gray-900 hover:bg-gray-700 text-white px-4 py-2.5 rounded-xl text-sm font-medium transition-colors">
            <i class="fa-solid fa-plus"></i> Add Role
        </a>
    </div>
</div>

<!-- KPI cards -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="stat-anim bg-white rounded-2xl border border-gray-100 shadow-sm p-5 group hover:shadow-md transition-all">
        <div class="flex items-start justify-between">
            <div><p class="text-xs text-gray-400 mb-1">Freelancers</p><p class="text-4xl font-extrabold text-gray-900 counter" data-target="@freelancerNum">0</p></div>
            <div class="w-11 h-11 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white transition-colors"><i class="fa-solid fa-users text-lg"></i></div>
        </div>
    </div>
    <div class="stat-anim bg-white rounded-2xl border border-gray-100 shadow-sm p-5 group hover:shadow-md transition-all">
        <div class="flex items-start justify-between">
            <div><p class="text-xs text-gray-400 mb-1">Projects</p><p class="text-4xl font-extrabold text-gray-900 counter" data-target="@projectsNum">0</p></div>
            <div class="w-11 h-11 rounded-xl bg-violet-100 text-violet-600 flex items-center justify-center group-hover:bg-violet-600 group-hover:text-white transition-colors"><i class="fa-solid fa-folder text-lg"></i></div>
        </div>
    </div>
    <div class="stat-anim bg-white rounded-2xl border border-gray-100 shadow-sm p-5 group hover:shadow-md transition-all">
        <div class="flex items-start justify-between">
            <div><p class="text-xs text-gray-400 mb-1">Tasks</p><p class="text-4xl font-extrabold text-gray-900 counter" data-target="@missionsNum">0</p></div>
            <div class="w-11 h-11 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors"><i class="fa-solid fa-list-check text-lg"></i></div>
        </div>
    </div>
    <div class="stat-anim bg-white rounded-2xl border border-gray-100 shadow-sm p-5 group hover:shadow-md transition-all">
        <div class="flex items-start justify-between">
            <div><p class="text-xs text-gray-400 mb-1">Clients</p><p class="text-4xl font-extrabold text-gray-900 counter" data-target="@clientsNum">0</p></div>
            <div class="w-11 h-11 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors"><i class="fa-solid fa-briefcase text-lg"></i></div>
        </div>
    </div>
</div>

<!-- Charts row 1 -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">
    <!-- Platform bar chart -->
    <div class="chart-card lg:col-span-2 bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
        <h2 class="text-base font-bold text-gray-900 mb-1">Platform Totals</h2>
        <p class="text-xs text-gray-400 mb-4">All metrics across registered freelancers</p>
        <canvas id="platformBar" height="120"></canvas>
    </div>

    <!-- Per-user doughnut -->
    <div class="chart-card bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
        <h2 class="text-base font-bold text-gray-900 mb-1">Avg per Freelancer</h2>
        <p class="text-xs text-gray-400 mb-3">Tasks · Projects · Clients</p>
        <canvas id="avgDonut" height="180"></canvas>
        <div class="mt-3 space-y-1.5">
            <div class="flex justify-between text-xs"><span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-blue-500 inline-block"></span>Tasks</span><strong>@(freelancerNum>0?Math.Round((double)missionsNum/freelancerNum,1):0)</strong></div>
            <div class="flex justify-between text-xs"><span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-violet-500 inline-block"></span>Projects</span><strong>@(freelancerNum>0?Math.Round((double)projectsNum/freelancerNum,1):0)</strong></div>
            <div class="flex justify-between text-xs"><span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-emerald-500 inline-block"></span>Clients</span><strong>@(freelancerNum>0?Math.Round((double)clientsNum/freelancerNum,1):0)</strong></div>
        </div>
    </div>
</div>

<!-- Charts row 2 -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    <!-- Radar -->
    <div class="chart-card bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
        <h2 class="text-base font-bold text-gray-900 mb-1">Platform Health</h2>
        <p class="text-xs text-gray-400 mb-3">Radar score across dimensions</p>
        <canvas id="adminRadar" height="200"></canvas>
    </div>
    <!-- Pie: freelancer vs metrics -->
    <div class="chart-card bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
        <h2 class="text-base font-bold text-gray-900 mb-1">Resource Split</h2>
        <p class="text-xs text-gray-400 mb-3">How workload is distributed</p>
        <canvas id="splitPie" height="200"></canvas>
    </div>
    <!-- Horizontal bar: per-freelancer breakdown -->
    <div class="chart-card bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
        <h2 class="text-base font-bold text-gray-900 mb-1">Per-User Breakdown</h2>
        <p class="text-xs text-gray-400 mb-3">Tasks and projects per user</p>
        <canvas id="perUserBar" height="200"></canvas>
    </div>
</div>

<!-- Search + freelancer list -->
<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-4">
    <div class="relative">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
        <input id="flSearch" type="text" placeholder="Search freelancers..."
               class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"/>
    </div>
</div>

<div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <h3 class="font-bold text-gray-900">Registered Freelancers</h3>
        <span class="text-xs text-gray-400 bg-gray-100 px-2.5 py-1 rounded-full">@freelancerNum total</span>
    </div>
    <div id="flList" class="divide-y divide-gray-50">
        @{ int fi=0; }
        @foreach (var fl in Model)
        {
            fi++;
            <div class="fl-card hover:bg-gray-50 transition-colors" data-name="@fl.UserName?.ToLower()">
                <div class="flex items-center justify-between px-6 py-4 cursor-pointer" onclick="toggleCard('@fi')">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg shrink-0">
                            @fl.UserName?.ToUpper().FirstOrDefault()
                        </div>
                        <div>
                            <p class="font-semibold text-gray-900 text-sm">@fl.UserName</p>
                            <p class="text-xs text-gray-500">@fl.ProjectCount projects · @fl.MissionCount tasks</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="hidden sm:flex gap-2">
                            <span class="text-xs bg-violet-100 text-violet-700 px-2 py-0.5 rounded-full font-medium">@fl.ProjectCount proj</span>
                            <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-medium">@fl.MissionCount tasks</span>
                        </div>
                        <i class="fa-solid fa-chevron-down text-gray-400 text-xs transition-transform" id="arrow-@fi"></i>
                    </div>
                </div>
                <div class="expand-content" id="expand-@fi">
                    <div class="px-6 pb-5 pt-1">
                        <div class="grid grid-cols-3 gap-3 bg-gray-50 rounded-xl p-4 mb-3">
                            <div class="text-center"><p class="text-2xl font-bold text-violet-600">@fl.ProjectCount</p><p class="text-xs text-gray-400">Projects</p></div>
                            <div class="text-center border-x border-gray-200"><p class="text-2xl font-bold text-blue-600">@fl.MissionCount</p><p class="text-xs text-gray-400">Tasks</p></div>
                            <div class="text-center"><p class="text-2xl font-bold text-emerald-600">@(fl.TodayHours.Hours)h</p><p class="text-xs text-gray-400">Today</p></div>
                        </div>
                        <!-- Mini bar for this user -->
                        <canvas id="userChart-@fi" height="55"></canvas>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (!Model.Any())
    {
        <div class="text-center py-12"><i class="fa-solid fa-users text-4xl text-gray-200 mb-3"></i><p class="text-gray-400 text-sm">No freelancers yet.</p></div>
    }
</div>

<script src="~/microsoft/signalr/dist/browser/signalr.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
document.getElementById('adminDate').textContent = new Date().toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});

/* Counters */
document.querySelectorAll('.counter').forEach(el=>{
    const t=parseInt(el.dataset.target)||0; let c=0; const s=Math.max(1,Math.ceil(t/40));
    const tick=()=>{ c=Math.min(c+s,t); el.textContent=c; if(c<t) requestAnimationFrame(tick); };
    new IntersectionObserver(e=>{ if(e[0].isIntersecting) tick(); }).observe(el);
});

const fl=@freelancerNum, pr=@projectsNum, ms=@missionsNum, cl=@clientsNum;

/* Platform bar */
new Chart(document.getElementById('platformBar'),{
    type:'bar',
    data:{ labels:['Freelancers','Projects','Tasks','Clients'],
        datasets:[{label:'Total',data:[fl,pr,ms,cl],
            backgroundColor:['rgba(99,102,241,.85)','rgba(139,92,246,.85)','rgba(59,130,246,.85)','rgba(16,185,129,.85)'],
            borderRadius:8,borderSkipped:false,borderWidth:0}]},
    options:{responsive:true,plugins:{legend:{display:false}},
        scales:{y:{beginAtZero:true,grid:{color:'#f3f4f6'}},x:{grid:{display:false}}}}
});

/* Avg doughnut */
const avgT=fl>0?Math.round(ms/fl):0, avgP=fl>0?Math.round(pr/fl):0, avgC=fl>0?Math.round(cl/fl):0;
new Chart(document.getElementById('avgDonut'),{
    type:'doughnut',
    data:{labels:['Tasks','Projects','Clients'],
        datasets:[{data:[avgT||1,avgP||1,avgC||1],
            backgroundColor:['rgba(59,130,246,.85)','rgba(139,92,246,.85)','rgba(16,185,129,.85)'],
            borderWidth:0,hoverOffset:8}]},
    options:{responsive:true,cutout:'68%',plugins:{legend:{display:false}}}
});

/* Radar */
new Chart(document.getElementById('adminRadar'),{
    type:'radar',
    data:{labels:['Users','Tasks','Projects','Clients','Avg Load','Coverage'],
        datasets:[{label:'Platform',
            data:[Math.min(100,fl*20),Math.min(100,ms*5),Math.min(100,pr*10),Math.min(100,cl*10),
                  fl>0?Math.min(100,Math.round((ms+pr)/fl*10)):0,Math.min(100,(fl+cl)*8)],
            backgroundColor:'rgba(99,102,241,.15)',borderColor:'#6366f1',borderWidth:2,
            pointBackgroundColor:'#6366f1',pointRadius:4}]},
    options:{responsive:true,scales:{r:{beginAtZero:true,max:100,ticks:{display:false},grid:{color:'#f3f4f6'}}},
        plugins:{legend:{display:false}}}
});

/* Split pie */
new Chart(document.getElementById('splitPie'),{
    type:'pie',
    data:{labels:['Tasks','Projects','Clients'],
        datasets:[{data:[ms,pr,cl],
            backgroundColor:['rgba(59,130,246,.85)','rgba(139,92,246,.85)','rgba(16,185,129,.85)'],
            borderColor:['#3b82f6','#8b5cf6','#10b981'],borderWidth:2,hoverOffset:10}]},
    options:{responsive:true,plugins:{legend:{position:'bottom',labels:{padding:10,usePointStyle:true,pointStyle:'circle'}}}}
});

/* Per-user horizontal bar */
const userLabels = [@Html.Raw(string.Join(",", Model.Select(f => $"'{f.UserName}'")))];
const userTasks  = [@Html.Raw(string.Join(",", Model.Select(f => f.MissionCount)))];
const userProjs  = [@Html.Raw(string.Join(",", Model.Select(f => f.ProjectCount)))];
new Chart(document.getElementById('perUserBar'),{
    type:'bar',
    data:{labels:userLabels.length?userLabels:['No data'],
        datasets:[
            {label:'Tasks',data:userTasks.length?userTasks:[0],backgroundColor:'rgba(59,130,246,.8)',borderRadius:4},
            {label:'Projects',data:userProjs.length?userProjs:[0],backgroundColor:'rgba(139,92,246,.8)',borderRadius:4}
        ]},
    options:{indexAxis:'y',responsive:true,
        scales:{x:{beginAtZero:true,stacked:false,grid:{color:'#f3f4f6'}},y:{grid:{display:false}}},
        plugins:{legend:{position:'bottom',labels:{padding:10,usePointStyle:true,pointStyle:'circle'}}}}
});

/* Expand + mini chart per user */
const userData = [@Html.Raw(string.Join(",", Model.Select(f => $"{{name:'{f.UserName}',tasks:{f.MissionCount},projects:{f.ProjectCount}}}")))]
let openId=null;
function toggleCard(id){
    if(openId && openId!==id){
        document.getElementById('expand-'+openId).classList.remove('open');
        document.getElementById('arrow-'+openId).style.transform='';
    }
    const el=document.getElementById('expand-'+id);
    const isOpen=el.classList.contains('open');
    el.classList.toggle('open',!isOpen);
    document.getElementById('arrow-'+id).style.transform=isOpen?'':'rotate(180deg)';
    openId=isOpen?null:id;

    // Draw mini chart
    if(!isOpen){
        setTimeout(()=>{
            const idx=parseInt(id)-1;
            const u=userData[idx];
            if(!u) return;
            const canvas=document.getElementById('userChart-'+id);
            if(!canvas||canvas._drawn) return;
            canvas._drawn=true;
            new Chart(canvas,{type:'bar',
                data:{labels:['Tasks','Projects'],
                    datasets:[{data:[u.tasks,u.projects],
                        backgroundColor:['rgba(59,130,246,.8)','rgba(139,92,246,.8)'],
                        borderRadius:6,borderSkipped:false}]},
                options:{responsive:true,plugins:{legend:{display:false}},
                    scales:{y:{beginAtZero:true,ticks:{stepSize:1},grid:{color:'#f3f4f6'}},x:{grid:{display:false}}}}
            });
        },200);
    }
}

/* Search */
let dt;
document.getElementById('flSearch').addEventListener('input',function(){
    clearTimeout(dt);
    dt=setTimeout(()=>{
        const q=this.value.toLowerCase();
        document.querySelectorAll('.fl-card').forEach(c=>{ c.style.display=!q||(c.dataset.name||'').includes(q)?'':'none'; });
    },180);
});

/* SignalR */
try{ new signalR.HubConnectionBuilder().withUrl("/statsHub").withAutomaticReconnect().build().start(); }catch(e){}
</script>
