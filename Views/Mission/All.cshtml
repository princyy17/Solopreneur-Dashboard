@using FreelanceManager.Enums
@model List<MissionViewModel>
@{
    ViewData["Title"] = "Tasks";
}

<style>
@@keyframes cardIn { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
.task-card { animation: cardIn 0.3s ease both; }
.filter-pill { transition: all 0.2s; }
.filter-pill.active { background:#1e293b; color:#fff; }
.view-btn.active { background:#e0e7ff; color:#4338ca; }
</style>

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
    <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900">Tasks</h1>
        <p class="text-gray-500 text-sm mt-1">
            <span id="visibleCount">@Model.Count</span> of @Model.Count tasks
            <kbd class="ml-2 text-xs border border-gray-300 rounded px-1 py-0.5 text-gray-400">Ctrl+N</kbd> to add
        </p>
    </div>
    <button id="btnAddMission"
            class="flex items-center gap-2 bg-gray-900 hover:bg-gray-700 text-white px-5 py-2.5 rounded-xl transition-colors text-sm font-medium shrink-0">
        <i class="fa-solid fa-plus"></i> Add Task
    </button>
</div>

<!-- Filter bar -->
<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-5">
    <div class="flex flex-col sm:flex-row gap-3">
        <!-- Live search -->
        <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input id="taskSearch" type="text" placeholder="Search tasks..."
                   class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" />
        </div>
        <!-- View toggle -->
        <div class="flex items-center gap-1 bg-gray-100 rounded-xl p-1">
            <button id="viewGrid" onclick="setView('grid')" class="view-btn active px-3 py-1.5 rounded-lg text-sm font-medium transition-colors">
                <i class="fa-solid fa-grip"></i>
            </button>
            <button id="viewList" onclick="setView('list')" class="view-btn px-3 py-1.5 rounded-lg text-sm font-medium transition-colors text-gray-500">
                <i class="fa-solid fa-list"></i>
            </button>
        </div>
    </div>

    <!-- Status pills -->
    <div class="flex flex-wrap gap-2 mt-3">
        <span class="text-xs text-gray-400 self-center mr-1">Status:</span>
        <button class="filter-pill active status-pill text-xs px-3 py-1.5 rounded-full border border-gray-200 font-medium" data-val="">All</button>
        <button class="filter-pill status-pill text-xs px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 font-medium" data-val="NotStarted">
            <span class="w-2 h-2 rounded-full bg-gray-400 inline-block mr-1"></span>Not Started
        </button>
        <button class="filter-pill status-pill text-xs px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 font-medium" data-val="InProgress">
            <span class="w-2 h-2 rounded-full bg-blue-500 inline-block mr-1"></span>In Progress
        </button>
        <button class="filter-pill status-pill text-xs px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 font-medium" data-val="Completed">
            <span class="w-2 h-2 rounded-full bg-green-500 inline-block mr-1"></span>Completed
        </button>

        <span class="w-px bg-gray-200 self-stretch mx-1"></span>
        <span class="text-xs text-gray-400 self-center mr-1">Priority:</span>
        <button class="filter-pill active priority-pill text-xs px-3 py-1.5 rounded-full border border-gray-200 font-medium" data-val="">All</button>
        <button class="filter-pill priority-pill text-xs px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 font-medium" data-val="High">
            <span class="w-2 h-2 rounded-full bg-red-500 inline-block mr-1"></span>High
        </button>
        <button class="filter-pill priority-pill text-xs px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 font-medium" data-val="Medium">
            <span class="w-2 h-2 rounded-full bg-yellow-500 inline-block mr-1"></span>Medium
        </button>
        <button class="filter-pill priority-pill text-xs px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 font-medium" data-val="Low">
            <span class="w-2 h-2 rounded-full bg-green-500 inline-block mr-1"></span>Low
        </button>
    </div>
</div>

<!-- Empty state -->
<div id="emptyState" class="hidden text-center py-16 bg-white rounded-2xl border border-gray-100">
    <i class="fa-solid fa-magnifying-glass text-4xl text-gray-300 mb-3"></i>
    <p class="text-gray-500 font-medium">No tasks match your filters</p>
    <button onclick="clearFilters()" class="mt-3 text-blue-600 text-sm hover:underline">Clear filters</button>
</div>

<!-- Cards container -->
<div id="taskContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 pb-8">
    @foreach (var results in Model)
    {
        <div class="task-card bg-white rounded-2xl shadow-sm border border-gray-100 p-4 hover:shadow-md transition-all"
             data-title="@results.Title.ToLower()"
             data-status="@results.Status"
             data-priority="@results.Priority"
             data-project="@results.ProjectName?.ToLower()">

            <!-- Top row: priority + actions -->
            @{
                var prioBg = results.Priority == priority.High ? "bg-red-100 text-red-700"
                           : results.Priority == priority.Medium ? "bg-amber-100 text-amber-700"
                           : "bg-green-100 text-green-700";
                var prioDot = results.Priority == priority.High ? "bg-red-500"
                            : results.Priority == priority.Medium ? "bg-amber-500"
                            : "bg-green-500";
            }
            <div class="flex items-start justify-between mb-3">
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full @prioBg">
                    <span class="w-1.5 h-1.5 rounded-full @prioDot"></span>@results.Priority
                </span>
                <div class="flex gap-1.5">
                    <button onclick="Details(@results.Id)" title="Details"
                            class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-500 flex items-center justify-center transition-colors">
                        <i class="fa-regular fa-eye text-xs"></i>
                    </button>
                    <button onclick="btnEditMission(@results.Id)" title="Edit"
                            class="w-7 h-7 rounded-lg bg-blue-100 hover:bg-blue-200 text-blue-600 flex items-center justify-center transition-colors">
                        <i class="fa-solid fa-pen text-xs"></i>
                    </button>
                    <button onclick="showDeleteModal('delete-form-@results.Id')" title="Delete"
                            class="w-7 h-7 rounded-lg bg-red-100 hover:bg-red-200 text-red-600 flex items-center justify-center transition-colors">
                        <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- Title -->
            <h3 class="font-bold text-gray-900 mb-1 leading-snug">@results.Title</h3>
            <p class="text-xs text-gray-400 mb-3 flex items-center gap-1">
                <i class="fa-solid fa-folder"></i> @results.ProjectName
            </p>

            <!-- Deadline -->
            @{ bool overdue = results.Deadline < DateTime.Now && results.Status.ToString() != "Completed"; }
            <div class="flex items-center gap-1.5 text-xs @(overdue ? "text-red-500" : "text-gray-500")">
                <i class="fa-regular fa-calendar @(overdue ? "text-red-400" : "")"></i>
                @if (overdue) { <span class="font-semibold">OVERDUE</span> }
                <span>@results.Deadline.ToString("dd MMM yyyy")</span>
            </div>

            <!-- Status badge -->
            @{
                var statusCls = results.Status.ToString() == "Completed" ? "bg-green-100 text-green-700"
                              : results.Status.ToString() == "InProgress"  ? "bg-blue-100 text-blue-700"
                              : "bg-gray-100 text-gray-600";
                var statusLabel = results.Status.ToString() == "InProgress" ? "In Progress"
                                : results.Status.ToString() == "NotStarted" ? "Not Started"
                                : "Completed";
            }
            <div class="mt-3">
                <span class="text-xs font-medium px-2.5 py-1 rounded-full @statusCls">@statusLabel</span>
            </div>

            <!-- Hidden delete form -->
            <form asp-action="Delete" method="post" id="delete-form-sumit-@results.Id" class="hidden">
                <input type="hidden" name="id" value="@results.Id" />
            </form>
            <!-- Delete Modal -->
            <div id="delete-form-@results.Id" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden">
                <div class="bg-white rounded-2xl shadow-2xl max-w-xs w-full mx-4 overflow-hidden">
                    <div class="bg-red-50 px-6 py-4 border-b border-red-100">
                        <div class="flex items-center gap-2">
                            <div class="w-9 h-9 bg-red-100 rounded-xl flex items-center justify-center">
                                <i class="fa-solid fa-trash text-red-600"></i>
                            </div>
                            <h3 class="font-bold text-gray-900">Delete Task</h3>
                        </div>
                    </div>
                    <div class="px-6 py-4">
                        <p class="text-sm text-gray-600">Are you sure? <strong class="text-gray-900">This action cannot be undone.</strong></p>
                    </div>
                    <div class="px-6 pb-5 flex gap-3">
                        <button type="button" onclick="closeDeleteModal('delete-form-@results.Id')"
                                class="flex-1 border border-gray-200 text-gray-700 hover:bg-gray-50 px-4 py-2.5 rounded-xl font-medium text-sm transition-colors">
                            Cancel
                        </button>
                        <button type="button" onclick="document.getElementById('delete-form-sumit-@results.Id').submit()"
                                class="flex-1 bg-red-600 hover:bg-red-700 text-white px-4 py-2.5 rounded-xl font-medium text-sm transition-colors">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- List view (hidden by default) -->
<div id="taskListView" class="hidden pb-8">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="grid grid-cols-12 gap-4 px-5 py-3 border-b border-gray-100 text-xs font-semibold text-gray-400 uppercase tracking-wide">
            <div class="col-span-4">Task</div>
            <div class="col-span-2">Project</div>
            <div class="col-span-2">Status</div>
            <div class="col-span-2">Priority</div>
            <div class="col-span-1">Deadline</div>
            <div class="col-span-1 text-right">Actions</div>
        </div>
        @foreach (var results in Model)
        {
            var rowPrio = results.Priority == priority.High ? "bg-red-100 text-red-700"
                         : results.Priority == priority.Medium ? "bg-amber-100 text-amber-700"
                         : "bg-green-100 text-green-700";
            var rowStatus = results.Status.ToString() == "Completed" ? "bg-green-100 text-green-700"
                          : results.Status.ToString() == "InProgress"  ? "bg-blue-100 text-blue-700"
                          : "bg-gray-100 text-gray-600";
            var rowLabel = results.Status.ToString() == "InProgress" ? "In Progress"
                         : results.Status.ToString() == "NotStarted" ? "Not Started" : "Completed";
            <div class="task-list-row grid grid-cols-12 gap-4 px-5 py-3.5 border-b border-gray-50 hover:bg-gray-50 transition-colors items-center"
                 data-title="@results.Title.ToLower()"
                 data-status="@results.Status"
                 data-priority="@results.Priority"
                 data-project="@results.ProjectName?.ToLower()">
                <div class="col-span-4 font-medium text-gray-900 text-sm">@results.Title</div>
                <div class="col-span-2 text-xs text-gray-500">@results.ProjectName</div>
                <div class="col-span-2"><span class="text-xs font-medium px-2 py-1 rounded-full @rowStatus">@rowLabel</span></div>
                <div class="col-span-2"><span class="text-xs font-medium px-2 py-1 rounded-full @rowPrio">@results.Priority</span></div>
                <div class="col-span-1 text-xs text-gray-500">@results.Deadline.ToString("dd MMM")</div>
                <div class="col-span-1 flex justify-end gap-1">
                    <button onclick="btnEditMission(@results.Id)" class="w-7 h-7 rounded-lg bg-blue-100 hover:bg-blue-200 text-blue-600 flex items-center justify-center"><i class="fa-solid fa-pen text-xs"></i></button>
                    <button onclick="showDeleteModal('delete-form-@results.Id')" class="w-7 h-7 rounded-lg bg-red-100 hover:bg-red-200 text-red-600 flex items-center justify-center"><i class="fa-solid fa-trash text-xs"></i></button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Overlay -->
<div id="modalOverlay" class="fixed inset-0 z-50 bg-black/50 hidden">
    <div id="modalContent" class="w-full max-w-2xl p-4 mx-auto mt-16"></div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
let currentStatus   = '';
let currentPriority = '';
let currentSearch   = '';
let currentView     = 'grid';

/* ── Add task ── */
$(document).ready(function(){
    $("#btnAddMission").click(function(){
        $.get('/Mission/Add', function(data){ $("#modalContent").html(data); $("#modalOverlay").removeClass("hidden"); });
    });
    $(document).on('click','#modalClose,#modalOverlay', function(e){
        if(e.target.id==="modalOverlay"||e.target.id==="modalClose") $("#modalOverlay").addClass("hidden");
    });
});
function btnEditMission(id){ $.get('/Mission/Edit/'+id,function(data){ $("#modalContent").html(data); $("#modalOverlay").removeClass("hidden"); }); }
function Details(id){ $.get('/Mission/Details/'+id,function(data){ $("#modalContent").html(data); $("#modalOverlay").removeClass("hidden"); }); }

/* ── View toggle ── */
function setView(v){
    currentView = v;
    if(v==='grid'){
        document.getElementById('taskContainer').classList.remove('hidden');
        document.getElementById('taskListView').classList.add('hidden');
        document.getElementById('viewGrid').classList.add('active');
        document.getElementById('viewList').classList.remove('active');
    } else {
        document.getElementById('taskContainer').classList.add('hidden');
        document.getElementById('taskListView').classList.remove('hidden');
        document.getElementById('viewList').classList.add('active');
        document.getElementById('viewGrid').classList.remove('active');
    }
    applyFilters();
}

/* ── Live filter ── */
let debounceTimer;
document.getElementById('taskSearch').addEventListener('input', function(){
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(()=>{ currentSearch = this.value.toLowerCase(); applyFilters(); }, 180);
});

document.querySelectorAll('.status-pill').forEach(btn => {
    btn.addEventListener('click', function(){
        document.querySelectorAll('.status-pill').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentStatus = this.dataset.val;
        applyFilters();
    });
});
document.querySelectorAll('.priority-pill').forEach(btn => {
    btn.addEventListener('click', function(){
        document.querySelectorAll('.priority-pill').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentPriority = this.dataset.val;
        applyFilters();
    });
});

function applyFilters(){
    const cards = document.querySelectorAll('#taskContainer .task-card');
    const rows  = document.querySelectorAll('.task-list-row');
    let visible = 0;
    const filterEl = (el) => {
        const t = el.dataset.title    || '';
        const s = el.dataset.status   || '';
        const p = el.dataset.priority || '';
        const proj = el.dataset.project || '';
        const matchSearch   = !currentSearch   || t.includes(currentSearch) || proj.includes(currentSearch);
        const matchStatus   = !currentStatus   || s === currentStatus;
        const matchPriority = !currentPriority || p === currentPriority;
        return matchSearch && matchStatus && matchPriority;
    };
    cards.forEach(c => { const show = filterEl(c); c.style.display = show ? '' : 'none'; if(show) visible++; });
    rows.forEach(r  => { r.style.display  = filterEl(r) ? '' : 'none'; });
    document.getElementById('visibleCount').textContent = visible;
    document.getElementById('emptyState').classList.toggle('hidden', visible > 0 || currentView !== 'grid');
}

function clearFilters(){
    document.getElementById('taskSearch').value = '';
    currentSearch = ''; currentStatus = ''; currentPriority = '';
    document.querySelectorAll('.status-pill,.priority-pill').forEach(b=>b.classList.remove('active'));
    document.querySelector('.status-pill[data-val=""]').classList.add('active');
    document.querySelector('.priority-pill[data-val=""]').classList.add('active');
    applyFilters();
}

/* ── Modals ── */
function showDeleteModal(id){ document.getElementById(id)?.classList.remove('hidden'); }
function closeDeleteModal(id){ document.getElementById(id)?.classList.add('hidden'); }

/* ── Keyboard shortcut ── */
document.addEventListener('keydown', e => {
    if((e.ctrlKey||e.metaKey) && e.key==='n'){
        e.preventDefault();
        document.getElementById('btnAddMission').click();
    }
});
</script>
